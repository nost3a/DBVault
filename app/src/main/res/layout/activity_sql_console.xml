<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="SQL"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnRun"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_run"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <TextView
        android:id="@+id/target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_dim"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:background="@color/bg"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="SELECT * FROM t LIMIT 20;"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btnClearEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_clear_sql"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnClearResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/action_clear_result"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/stat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="24dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
